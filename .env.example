# Development Environment Configuration
NODE_ENV=
PORT=

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civic_report
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=civic_report

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
FIREBASE_PROJECT_ID=civic-report-firebase
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# External API Keys
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=
OPENAI_MAX_TOKENS=

# Google Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Twitter API
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=civic-report-images
AWS_S3_REGION=us-east-1

# Application Settings
CORS_ORIGIN=*
API_RATE_LIMIT=100
API_RATE_WINDOW=60000
MAX_UPLOAD_SIZE=10485760
SUPPORTED_IMAGE_FORMATS=jpg,jpeg,png,webp

# Queue Configuration
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=5000
QUEUE_CONCURRENCY=5

# Monitoring
LOG_LEVEL=debug
ENABLE_SWAGGER=true

# Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@civicreport.com
