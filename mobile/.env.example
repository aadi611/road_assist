# React Native Environment Configuration

# API Configuration
API_BASE_URL=http://localhost:3000/api/v1
API_TIMEOUT=30000

# Firebase Configuration
FIREBASE_PROJECT_ID=civic-report-firebase
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=civic-report-firebase.firebaseapp.com
FIREBASE_STORAGE_BUCKET=civic-report-firebase.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# App Configuration
APP_NAME=CivicReport
APP_VERSION=1.0.0
ENVIRONMENT=development

# Feature Flags
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false

# Camera Settings
MAX_IMAGE_SIZE=5242880
IMAGE_QUALITY=0.8
CAMERA_FLASH_MODE=auto

# Location Settings
LOCATION_TIMEOUT=10000
LOCATION_MAX_AGE=30000
LOCATION_ACCURACY=high
